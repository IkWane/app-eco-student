# Copier en .env et remplacer les valeurs. Ne jamais commiter .env.

# API
PORT=3000
# Au moins 32 caractères. Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme_changeme_changeme_changeme
# URL du front autorisée par CORS (Vite)
CORS_ORIGIN=http://localhost:5173

# MySQL (lu par docker-compose.yml et par l'API)
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_HOST=localhost
MYSQL_DATABASE=eco_student
MYSQL_USER=eco
MYSQL_PASSWORD=changeme
MYSQL_PORT=3306
